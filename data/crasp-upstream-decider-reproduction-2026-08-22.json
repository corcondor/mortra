      "regex": "(cab+c)*",
      "R": false,
      "C-RASP": false,
      "R_infinity": false,
      "R_G": false
    },
    {
      "regex": "(ab+ba)*",
      "R": false,
      "C-RASP": true,
      "R_infinity": true,
      "R_G": true
    },
    {
      "regex": "(aabb)*",
      "R": false,
      "C-RASP": true,
      "R_infinity": true,
      "R_G": true
    }
  ],
  "interpretation": "This reproduces the upstream regular-language classifier only. It is not a MORTRA proof-search score."

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Migration only (service_role — never expose to frontend)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# X posting (required for /api/post)
X_API_KEY=...
X_API_SECRET=...
X_ACCESS_TOKEN=...
X_ACCESS_TOKEN_SECRET=...
# TWITTER_CONSUMER_KEY / TWITTER_CONSUMER_SECRET / TWITTER_ACCESS_TOKEN /
# TWITTER_ACCESS_TOKEN_SECRET are also accepted as aliases.

# Optional local fallback for existing JSON config. Do not use in Vercel.
# X_CONFIG_PATH=C:\path\to\config.json

# Local-only Python actions (SQLite sync only)
PYTHON_BIN=python
# ENABLE_VERCEL_PYTHON_ACTIONS=1  # only if scripts/*.py are deployed and Python is available

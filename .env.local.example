# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-side only. Never expose this value to the browser.
SUPABASE_SERVICE_KEY=replace-with-service-role-key

# Optional X publishing
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional local-only Python actions
PYTHON_BIN=python
# ENABLE_VERCEL_PYTHON_ACTIONS=1
